# Records the articles Readroom was asked to read aloud, one at a time.
# Install as a user unit, next to the summariser's:
#   cp deploy/systemd/readroom-speak.* ~/.config/systemd/user/
#   install -D bin/readroom ~/.local/bin/readroom
#   install -D deploy/tts/tiny-voca-speak ~/.local/bin/tiny-voca-speak
#   systemctl --user daemon-reload && systemctl --user enable --now readroom-speak.timer
# It needs ffmpeg, and for tiny-voca-speak also uv (https://docs.astral.sh/uv/), both on the PATH below.
# The access token comes from the same ~/.config/readroom/env as the summariser's:
#   READROOM_TOKEN=...            (chmod 600)
[Unit]
Description=Readroom: record the articles asked to be read aloud

[Service]
Type=oneshot
EnvironmentFile=%h/.config/readroom/env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
# Skip quietly until the token has been filled in.
ExecCondition=/bin/sh -c 'grep -q "^READROOM_TOKEN=." %h/.config/readroom/env'
# Edit -api to your Readroom address. -cmd is any program that reads text on standard
# input and writes audio to standard output; -voice is the name shown with the recording.
ExecStart=%h/.local/bin/readroom speak -api https://readroom.example.ts.net -cmd tiny-voca-speak -voice "tiny-voca M2"
Nice=10
TimeoutStartSec=45min
